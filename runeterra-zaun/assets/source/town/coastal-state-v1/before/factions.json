        "special2": {
          "name": "Augmentation Clinic",
          "description": "Click with a visiting hero to receive a ten point mana top-up, limited to the mana the hero is missing. The native visit mode records the claiming hero, so each hero may take the treatment once and the weekly reset clears those records: several heroes may each claim it in the same week. The clinic is a bounded logistical service; it grants no combat stats and no implant slots.",
          "cost": {
            "gold": 4500,
            "ore": 8,
            "wood": 5
          },
          "requires": [
            "allOf",
            [
              "tavern"
            ],
            [
              "mageGuild2"
            ]
          ],
          "manualHeroVisit": true,
          "configuration": {
            "visitMode": "hero",
            "resetParameters": {
              "weeks": 1,
              "visitors": true
            },
            "rewards": [
              {
                "message": "The clinic tops your hero's mana back up by up to ten points. Each hero may be treated once; the treatment becomes available again next week.",
                "manaPoints": 10
              }
            ]
          }
        },
