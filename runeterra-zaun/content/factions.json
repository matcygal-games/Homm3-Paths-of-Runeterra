            "dwellingLvl3"
          ]
        },
        "dwellingLvl5": {
          "cost": {
            "gold": 3500,
            "ore": 10,
            "wood": 5
          },
          "description": "Recruits living Chem-Barons with six physical flask shots and one separately paid Basic Weakness cast per stack per battle. Normal ranged penalties and ordinary living rules apply.",
