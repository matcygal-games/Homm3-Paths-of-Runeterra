  "background_constraints": [
    "All ordinary full foundations and door approaches dry. Only the named river quay deliberately enters water and must have piers and a continuous gangway.",
    "Empty backdrop carries terraces, stairs, incidental city support walls, drainage channels and vegetation only; no finished functional site architecture.",
    "Curving routes, varied heights and three asymmetrical monumental volumes join one inhabited arcology edge; avoid three straight catalogue bands.",
    "Keep exposed streets/courtyards as community connections, not repeated opaque building floor tiles.",
    "No wide forest foreground masks; preserve view of full native city including early and all upgrades."
  ],
  "crest": {
    "url": "https://universe.leagueoflegends.com/images/ixtal_crest_icon@2x.png",
    "sha256": "4837f95e3a7504627678742fb858b4c05f180e63e07d082651194cd0daf22450",
    "form": "Tall tapered stem with small flared fan cap/branch cutouts, broad upswept lower crescent arms, interlaced elongated diamond lattice downward point.",
    "placement": "Fixed civic/route banner at city entrance visible on empty/early plate, plus generous physical jade/gold cloth or carved plaque on every institutional family. Fixed banner is incidental, never a constructible building."
  },
