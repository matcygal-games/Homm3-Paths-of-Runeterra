      "buildings": {
        "villageHall":{"name":"Arcology Steward's Court","description":"Produces 500 gold daily. This compressed district is project fiction, not a second literal Ixaocan.","cost":{"gold":500},"produce":{"gold":500}},
        "townHall":{"name":"Terrace Council","description":"Produces 1000 gold daily.","cost":{"gold":2500},"upgrades":"villageHall","requires":["tavern"],"produce":{"gold":1000}},
        "cityHall":{"name":"Yun Tal Council Hall","description":"Produces 2000 gold daily. Administrative game adaptation; it does not establish Qiyana's accession or a unanimous ruling caste.","cost":{"gold":5000},"upgrades":"townHall","requires":["allOf",["marketplace"],["blacksmith"],["mageGuild1"]],"produce":{"gold":2000}},
        "capitol":{"name":"High Terrace Council","description":"Produces 4000 gold daily. Native one-Capitol-per-player restriction applies.","cost":{"gold":10000},"upgrades":"cityHall","requires":["castle"],"produce":{"gold":4000}},
        "fort":{"name":"Canopy Gate","description":"Native defensive walls. Ordinary base recruitment growth is unchanged.","cost":{"gold":5000,"wood":20,"ore":20}},
        "citadel":{"name":"Terrace Citadel","description":"Native moat and keep. Ordinary base growth increases by fifty percent before Canopy Routes adds its flat recruit.","cost":{"gold":2500,"ore":5},"upgrades":"fort"},
        "castle":{"name":"Arcology Bastion","description":"Native castle defenses and double ordinary base growth. Canopy Routes adds its flat recruit afterward.","cost":{"gold":5000,"wood":10,"ore":10},"upgrades":"citadel"},
        "mageGuild1":{"name":"Axiom Campus I","description":"Teaches native level-one spells. Disciplined elemental study does not introduce a new magic school.","cost":{"gold":2000,"wood":5,"ore":5}},
        "mageGuild2":{"name":"Axiom Campus II","description":"Teaches native level-two spells.","cost":{"gold":1000,"wood":5,"ore":5,"mercury":4,"sulfur":4,"crystal":4,"gems":4},"upgrades":"mageGuild1"},
        "mageGuild3":{"name":"Axiom Campus III","description":"Teaches native level-three spells.","cost":{"gold":1000,"wood":5,"ore":5,"mercury":6,"sulfur":6,"crystal":6,"gems":6},"upgrades":"mageGuild2"},
        "mageGuild4":{"name":"Axiom Campus IV","description":"Teaches native level-four spells. Spell availability and mana costs remain native.","cost":{"gold":1000,"wood":5,"ore":5,"mercury":8,"sulfur":8,"crystal":8,"gems":8},"upgrades":"mageGuild3"},
        "mageGuild5":{"name":"Axiom Campus V","description":"Teaches native level-five spells. No free elemental stacks or permanent weather control.","cost":{"gold":1000,"wood":5,"ore":5,"mercury":10,"sulfur":10,"crystal":10,"gems":10},"upgrades":"mageGuild4"},
        "tavern":{"name":"The Open Canopy","description":"Recruits ordinary skirmish heroes and retains native Thieves Guild information and +1 town-defender Morale. Employment is a gameplay abstraction, not a canonical alliance.","cost":{"gold":500,"wood":5},"bonuses":[{"type":"MORALE","val":1},{"type":"THIEVES_GUILD_ACCESS","val":1,"propagator":"PLAYER"}]},
        "marketplace":{"name":"River Court Market","description":"Trades the seven native resources at ordinary marketplace rates. Gold remains Gold.","cost":{"gold":500,"wood":5}},
        "blacksmith":{"name":"Terrace Healers' Workshop","description":"Sells the ordinary native First Aid Tent. Healing requires its native battle actions and limitations; no daily restoration of nonpersistent wounded stacks.","cost":{"gold":1000,"wood":5},"warMachine":"core:firstAidTent"},
        "resourceSilo":{"name":"Jade Repository","description":"Produces one native gem daily for the current owner. No artifact factory, duplicated silo income or conscious-crystal harvest.","cost":{"gold":5000,"ore":10},"requires":["marketplace"],"produce":{"gems":1}},
        "special1":{"name":"Canopy Routes","description":"The negotiated refuge/recruitment network adds one Pakaa to the shared tier-three weekly pool after fortification growth: 7/10/13 at Fort/Citadel/Castle before Grail. Sanctuary recruitment is project fiction, not universal domestication.","cost":{"gold":2500,"wood":5,"ore":5,"gems":2},"requires":["allOf",["dwellingLvl3"],["townHall"]],"bonuses":[{"type":"CREATURE_GROWTH","subtype":"creatureLevel3","val":1}]},
        "special2":{"name":"Elemental Nexus","description":"The first eligible town visitor each week restores up to 20 missing mana, capped at normal maximum. A full-mana visitor leaves this town's weekly claim available; capture does not grant another claim.","cost":{"gold":3500,"wood":5,"ore":5,"gems":3},"requires":["allOf",["townHall"],["mageGuild2"]],"manualHeroVisit":false,"configuration":{"canRefuse":false,"visitMode":"once","selectMode":"selectFirst","showInInfobox":true,"resetParameters":{"visitors":true,"weeks":1},"onEmptyMessage":"Your mana is full. The Nexus keeps this week's assistance for an eligible visitor.","onVisitedMessage":"This town has already allocated its restorative study this week.","rewards":[{"limiter":{"noneOf":[{"manaPercentage":100}]},"manaPoints":20,"manaOverflowFactor":0,"message":"Guided study restores up to 20 missing mana, without exceeding your normal maximum."}]}},
        "dwellingLvl1":{"name":"Canopy Wayhouse","description":"Recruits adult Canopy Guides from the shared tier-one pool.","cost":{"gold":500,"wood":5},"requires":["fort"]},
        "dwellingUpLvl1":{"name":"Tracker Wayhouse","description":"Recruits Canopy Trackers from the same tier-one pool.","cost":{"gold":1000,"wood":5},"upgrades":"dwellingLvl1"},
        "dwellingLvl2":{"name":"Bristlehog Refuge","description":"Recruits Bristlehogs. Organized defensive participation is an explicit game adaptation.","cost":{"gold":1000,"wood":5,"ore":5},"requires":["dwellingLvl1"]},
        "dwellingUpLvl2":{"name":"Thornback Refuge","description":"Recruits mature Thornback Bristlehogs from the same pool, not a second population.","cost":{"gold":1500,"wood":5,"ore":5},"upgrades":"dwellingLvl2"},
        "dwellingLvl3":{"name":"Pakaa Glade","description":"Recruits adult Pakaa Prowlers through a fictional local-defense pact, not a royal breeding program.","cost":{"gold":1500,"wood":10},"requires":["dwellingLvl1"]},
        "dwellingUpLvl3":{"name":"Guardian Glade","description":"Recruits mature Pakaa Guardians from the same pool.","cost":{"gold":2000,"wood":5,"ore":5},"upgrades":"dwellingLvl3"},
        "dwellingLvl4":{"name":"Stoneshapers' Court","description":"Recruits living Stoneshapers. Their physical stone shots and finite Stone Skin support are game adaptations.","cost":{"gold":2500,"wood":5,"ore":10,"gems":2},"requires":["allOf",["dwellingLvl2"],["mageGuild1"]]},
        "dwellingUpLvl4":{"name":"Axiom Stoneshapers' Court","description":"Recruits Axiom Stoneshapers from the same pool. Cast and shot compete for the stack's action.","cost":{"gold":3000,"wood":5,"ore":5,"gems":2},"upgrades":"dwellingLvl4","requires":["mageGuild2"]},
        "dwellingLvl5":{"name":"Path Warden Lodge","description":"Recruits Path Wardens, adapted from the region's route-protection institution.","cost":{"gold":3500,"wood":10,"ore":5},"requires":["allOf",["dwellingLvl3"],["mageGuild1"]]},
        "dwellingUpLvl5":{"name":"Veteran Warden Lodge","description":"Recruits Veteran Path Wardens from the same pool.","cost":{"gold":4500,"wood":5,"ore":10,"gems":2},"upgrades":"dwellingLvl5","requires":["mageGuild2"]},
        "dwellingLvl6":{"name":"Hallunatis Aerie","description":"Recruits living Aurora Hallunatis. Flight and organized recruitment are the documented Heroes III adaptation.","cost":{"gold":6000,"wood":10,"ore":10,"gems":3},"requires":["allOf",["dwellingLvl4"],["mageGuild2"]]},
        "dwellingUpLvl6":{"name":"Crowned Hallunatis Aerie","description":"Recruits Crowned Hallunatis from the same pool. Legal landing space and native flight rules still apply.","cost":{"gold":6500,"wood":10,"ore":10,"gems":3},"upgrades":"dwellingLvl6","requires":["mageGuild3"]},
        "dwellingLvl7":{"name":"Pairofant Sanctuary","description":"Recruits grounded living Pairofants through an explicit game-fiction pact. These are not copies of Skarner or Malphite.","cost":{"gold":10000,"wood":15,"ore":10,"gems":5},"requires":["allOf",["dwellingLvl5"],["mageGuild3"]]},
        "dwellingUpLvl7":{"name":"Elder Pairofant Sanctuary","description":"Recruits Elder Pairofants from the same pool. Their size grants no flight, blanket immunity or automatic resurrection.","cost":{"gold":15000,"wood":15,"ore":15,"gems":10},"upgrades":"dwellingLvl7","requires":["allOf",["mageGuild4"],["resourceSilo"]]},
        "shipyard":{"name":"River Landing","description":"Native Shipyard, buildable only with legal coastal access. Land construction does not require it.","cost":{"gold":2000,"wood":20}},
        "ship":{"name":"Moored River Sloop","description":"Native optional moored-vessel display including its dock composite.","cost":{},"mode":"special","requires":["shipyard"]},
        "grail":{"name":"Convergence of Axioms","description":"Native Grail income and growth exactly once. An earned optional monument, not a free relic, weather engine or permanent new magic school.","cost":{},"mode":"grail"}
