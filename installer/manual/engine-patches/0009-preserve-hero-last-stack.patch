+/* Preserve the native nonempty-hero rule when the AI rearranges armies.
+ * GPL-2.0-or-later. This has no saved/network state and uses normal callbacks. */
+#pragma once
+
+namespace NK2AI::detail
+{
+template<class Callback, class Army, class Slot>
+bool mergeOrSwapPreservingLast(Callback & callback, const Army * from, const Army * to, Slot fromSlot, Slot toSlot)
+{
+	if(from != to && from->needsLastStack() && from->stacksCount() == 1
+		&& (!to->hasStackAtSlot(toSlot) || to->getCreature(toSlot) == from->getCreature(fromSlot)))
+	{
+		const auto quantity = from->getStackCount(fromSlot);
+		if(quantity <= 1)
+			return false;
+		callback.splitStack(from, to, fromSlot, toSlot, to->getStackCount(toSlot) + quantity - 1);
+		return true;
+	}
+	callback.mergeOrSwapStacks(from, to, fromSlot, toSlot);
+	return true;
+}
+
+template<class Callback, class Army, class Slot>
+bool giveOnePreservingLast(Callback & callback, const Army * from, const Army * to, Slot fromSlot, Slot toSlot)
+{
+	if(!fromSlot.validSlot() || !toSlot.validSlot() || !from->hasStackAtSlot(fromSlot))
+		return false;
+	if(from != to && from->needsLastStack() && from->stacksCount() == 1 && from->getStackCount(fromSlot) <= 1)
+		return false;
+	callback.splitStack(from, to, fromSlot, toSlot, to->getStackCount(toSlot) + 1);
+	return true;
+}
+}
