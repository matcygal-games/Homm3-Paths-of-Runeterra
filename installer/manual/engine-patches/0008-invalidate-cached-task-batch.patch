+PlannedTaskResult Nullkiller::executePlannedTask(const Goals::TTask & task)
+{
+	// TaskPlan only compares affected object IDs. Moving an unrelated hero can
+	// still block this task's route, so the remainder of this snapshot must not
+	// execute after the existing path invalidation callback has fired.
+	if(pathfinderInvalidated)
+	{
+		// Other heroes moving can leave this simple route unaffected. Validate
+		// it against fresh native paths before spending another planning pass.
+		invalidatePaths();
+		const CGHeroInstance * movementHero = nullptr;
+		bool foundChain = false;
+		if(!hasReusableMovementPath(*this, task.get(), movementHero, foundChain))
+		{
+			logAi->debug("Discarding remaining cached task batch after path-changing event. Replanning.");
+			return PlannedTaskResult::REPLAN;
+		}
+		logAi->debug("Revalidated unaffected single-hero land task after path-changing event.");
+	}
+
+	return executeTask(task) ? PlannedTaskResult::SUCCESS : PlannedTaskResult::FAILED;
+}
