+/// A cached task batch is invalid after hero movement or another path-changing event.
+enum class PlannedTaskResult
+{
+	SUCCESS,
+	FAILED,
+	REPLAN
+};
+
+/// Refreshing a stale snapshot must not consume the original batch's action allowance.
+/// Both successful tasks and refresh attempts remain bounded by that batch size.
+class PlanningPassBudget
+{
+	size_t tasksRemaining;
+	size_t refreshesRemaining;
+public:
+	explicit PlanningPassBudget(size_t initialTasks)
+		: tasksRemaining(initialTasks), refreshesRemaining(initialTasks) {}
+	bool canExecuteTask() const { return tasksRemaining != 0; }
+	void noteSuccessfulTask()
+	{
+		assert(tasksRemaining != 0);
+		--tasksRemaining;
+	}
+	bool consumeRefresh(bool resourcesTradedNow = false)
+	{
+		if(resourcesTradedNow || !tasksRemaining || !refreshesRemaining)
+			return false;
+		--refreshesRemaining;
+		return true;
+	}
+};
 
