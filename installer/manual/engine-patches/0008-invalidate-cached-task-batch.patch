+class CountedPlanGoal : public NK2AI::Goals::ElementarGoal<CountedPlanGoal>
+{
+	int * executions;
+	bool fail;
+public:
+	CountedPlanGoal(int & counter, bool shouldFail = false)
+		: ElementarGoal(NK2AI::Goals::EXECUTE_HERO_CHAIN), executions(&counter), fail(shouldFail)
+	{
+	}
+	bool operator==(const CountedPlanGoal & other) const override
+	{
+		return executions == other.executions && fail == other.fail;
+	}
+	void accept(NK2AI::AIGateway *) override
+	{
+		++*executions;
+		if(fail)
+			throw NK2AI::cannotFulfillGoalException("expected task dispatch failure");
+	}
+	std::string toString() const override { return "CountedPlanGoal"; }
+};
