+	{
+		return ai.hasUnspentHeroMovement();
+	}
+
+	static PlannedTaskResult executePlannedTask(Nullkiller & ai, const Goals::TTask & task)
+	{
+		return ai.executePlannedTask(task);
+	}
+
+	static void refreshState(Nullkiller & ai)
+	{
+		ai.updateState();
+	}
+
+	static bool executeTask(Nullkiller & ai, const Goals::TTask & task)
+	{
+		return ai.executeTask(task);
+	}
+
+	static void prepareState(Nullkiller & ai)
+	{
+		ai.resetState();
+		ai.updateState();
+	}
+};
