+		gateway->initGameInterface(std::shared_ptr<Environment>(), callback);
+		return gateway;
+	}
+
+	std::unique_ptr<NK2AI::AIGateway> makeGateway(PlayerColor player, IClient * client = nullptr)
+	{
+		return makeGateway(makeCallback(player, client));
+	}
