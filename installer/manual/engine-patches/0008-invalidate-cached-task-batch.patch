+// Only ordinary single-hero land movement may reuse a globally invalidated
+// task snapshot. Exchanges, spells and other semantic actions require a replan.
+bool hasReusableMovementPath(
+	const Nullkiller & ai,
+	const Goals::ITask * task,
+	const CGHeroInstance * & movementHero,
+	bool & foundChain,
+	unsigned depth = 0)
+{
+	if(depth > 8)
+		return false;
+
+	if(const auto * chain = dynamic_cast<const ExecuteHeroChain *>(task))
+	{
+		if(foundChain)
+			return false; // A second cached route would start with different MP/position.
+		const auto & path = chain->getPath();
+		const auto * hero = path.targetHero;
+		if(!hero || path.nodes.empty() || path.exchangeCount != 1
+			|| !HeroPtr(hero, ai.cc.get()).isVerified(false)
+			|| hero->getOwner() != ai.playerID
+			|| (movementHero && movementHero != hero))
+			return false;
+
+		movementHero = hero;
+		const auto livePaths = ai.getPathsInfo(hero);
+		size_t movementTargets = 0;
+		for(const auto & node : path.nodes)
+		{
+			if(node.targetHero != hero || node.layer != EPathfindingLayer::LAND
+				|| node.specialAction || node.actionIsBlocked)
+				return false;
+			if(node.coord == hero->visitablePos())
+				continue;
+			if(++movementTargets > 1)
+				return false; // Multiple legs require sequential position/MP accounting.
+			const auto * live = livePaths->getPathInfo(node.coord);
+			if(!live->reachable() || live->turns > node.turns)
+				return false;
+
+			// A currently reachable target is insufficient if the route now
+			// crosses combat, teleportation, boarding or another blocking visit.
+			for(const auto * step = live; step->theNodeBefore; step = step->theNodeBefore)
+			{
+				if(step->layer != EPathfindingLayer::LAND
+					|| (step->action != EPathNodeAction::NORMAL && step->action != EPathNodeAction::VISIT)
+					|| (step->accessible != EPathAccessibility::ACCESSIBLE
+						&& step->accessible != EPathAccessibility::VISITABLE))
+					return false;
+			}
+		}
+		if(movementTargets != 1)
+			return false;
+		foundChain = true;
+		return true;
+	}
+
+	if(const auto * composition = dynamic_cast<const Composition *>(task))
+	{
+		for(const auto & part : composition->decompose(&ai))
+		{
+			if(part->isElementar()
+				&& !hasReusableMovementPath(ai, part->asTask(), movementHero, foundChain, depth + 1))
+				return false;
+		}
+		return foundChain;
+	}
+
+	// This tail chooses its own immediate target from fresh native paths in
+	// accept(); it does not consume another cached route from the old plan.
+	if(dynamic_cast<const ExploreNeighbourTile *>(task))
+		return foundChain && task->getHero() == movementHero;
+
+	return false;
+}
+
 }
 
