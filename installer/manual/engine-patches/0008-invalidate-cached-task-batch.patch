+	EXPECT_EQ(NK2AI::NullkillerTestAccess::executePlannedTask(*gateway->nullkiller, cachedTask),
+		NK2AI::PlannedTaskResult::REPLAN);
+	EXPECT_EQ(partner->visitablePos(), before);
+	EXPECT_EQ(client->movementRequests, 1);
+}
+
+TEST(CachedTaskBatchBudgetTest, staleRefreshPreservesUnfinishedOriginalBatchWork)
+{
+	NK2AI::PlanningPassBudget budget(3);
+	budget.noteSuccessfulTask();
+	ASSERT_TRUE(budget.consumeRefresh());
+	ASSERT_TRUE(budget.canExecuteTask());
+	budget.noteSuccessfulTask();
+	ASSERT_TRUE(budget.consumeRefresh());
+	ASSERT_TRUE(budget.canExecuteTask());
+	budget.noteSuccessfulTask();
+	EXPECT_FALSE(budget.canExecuteTask());
+	EXPECT_FALSE(budget.consumeRefresh());
+}
+
+TEST(CachedTaskBatchBudgetTest, repeatedRefreshWithoutProgressIsBounded)
+{
+	NK2AI::PlanningPassBudget budget(2);
+	EXPECT_TRUE(budget.consumeRefresh());
+	EXPECT_TRUE(budget.consumeRefresh());
+	EXPECT_FALSE(budget.consumeRefresh())
+		<< "a stream of invalidations must eventually return to the bounded outer pass";
+	EXPECT_TRUE(budget.canExecuteTask());
+}
+
+TEST(CachedTaskBatchBudgetTest, refreshedPlansCannotExpandOriginalTaskAllowance)
+{
+	NK2AI::PlanningPassBudget budget(2);
+	int completed = 0;
+	for(int candidate = 0; candidate < 20 && budget.canExecuteTask(); ++candidate)
+	{
+		budget.noteSuccessfulTask();
+		++completed;
+		budget.consumeRefresh();
+	}
+	EXPECT_EQ(completed, 2)
+		<< "replanning must not multiply the original per-pass action allowance";
+}
+
+TEST(CachedTaskBatchBudgetTest, emptyBatchCannotExecuteOrRefresh)
+{
+	NK2AI::PlanningPassBudget budget(0);
+	EXPECT_FALSE(budget.canExecuteTask());
+	EXPECT_FALSE(budget.consumeRefresh());
+}
+
+TEST(CachedTaskBatchBudgetTest, resourceTradeRequiresNewPriorityPassBeforeRefresh)
+{
+	NK2AI::PlanningPassBudget budget(2);
+	budget.noteSuccessfulTask();
+	EXPECT_FALSE(budget.consumeRefresh(true))
+		<< "newly funded town purchases require priority planning before another movement-only refresh";
+	EXPECT_TRUE(budget.consumeRefresh(false))
+		<< "declining a movement refresh for real economic progress must not silently spend refresh credit";
+}
+
+TEST(CachedTaskBatchBudgetTest, completedBatchCannotSpendUnusedRefreshCredit)
+{
+	NK2AI::PlanningPassBudget budget(1);
+	budget.noteSuccessfulTask();
+	EXPECT_FALSE(budget.consumeRefresh());
+	EXPECT_FALSE(budget.canExecuteTask());
+}
+
+TEST_F(CachedTaskBatchTest, exhaustedAndLockedHeroesDoNotKeepTurnOpen)
+{
+	startGame();
+	auto * partner = findHeroAt(int3(10, 10, 0));
+	ASSERT_NE(partner, nullptr);
+	hero->setMovementPoints(0);
+	partner->setMovementPoints(0);
+	auto & ai = *gateway->nullkiller;
+	EXPECT_FALSE(NK2AI::NullkillerTestAccess::hasUnspentHeroMovement(ai));
+	partner->setMovementPoints(1630);
+	ai.lockHero(partner, NK2AI::HeroLockedReason::HERO_CHAIN);
+	EXPECT_FALSE(NK2AI::NullkillerTestAccess::hasUnspentHeroMovement(ai));
+	ai.unlockHero(partner);
+	EXPECT_TRUE(NK2AI::NullkillerTestAccess::hasUnspentHeroMovement(ai))
+		<< "an unlocked hero with the observed remaining movement must keep planning open";
+}
+
+TEST_F(CachedTaskBatchTest, smallPositiveRoadMovementIsNotPrematurelyComplete)
+{
+	startGame();
+	auto * partner = findHeroAt(int3(10, 10, 0));
+	ASSERT_NE(partner, nullptr);
+	hero->setMovementPoints(0);
+	partner->setMovementPoints(75);
+	EXPECT_TRUE(NK2AI::NullkillerTestAccess::hasUnspentHeroMovement(*gateway->nullkiller))
+		<< "completion detection must not reuse the old greater-than-100 worthwhile-task threshold";
 }
 
