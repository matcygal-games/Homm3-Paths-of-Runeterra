+void CVCMIServer::closeConnection(const std::shared_ptr<INetworkConnection> & connection)
+{
+	{
+		std::lock_guard<std::mutex> lock(requestedConnectionClosuresMutex);
+		for(auto it = requestedConnectionClosures.begin(); it != requestedConnectionClosures.end();)
+		{
+			if(it->expired())
+				it = requestedConnectionClosures.erase(it);
+			else
+				++it;
+		}
+		requestedConnectionClosures.insert(connection);
+	}
+	connection->close();
+}
+
 void CVCMIServer::onDisconnected(const std::shared_ptr<INetworkConnection> & connection, const std::string & errorMessage)
 {
-	logNetwork->error("Network error receiving a pack. Connection has been closed");
+	bool requestedClose;
+	{
+		std::lock_guard<std::mutex> lock(requestedConnectionClosuresMutex);
+		requestedClose = requestedConnectionClosures.find(connection) != requestedConnectionClosures.end();
+	}
+	if(requestedClose)
+	{
+		logNetwork->debug("Connection closed after explicit local close request: %s", errorMessage);
+		return;
+	}
+
+	logNetwork->error("Network error receiving a pack. Connection has been closed: %s", errorMessage);
 
 	std::shared_ptr<GameConnection> c = findConnection(connection);
 
