+TEST(LocalServerDiscovery, genuineLanDiscoveryRepliesWithActualTcpPortAndAcceptsConnection)
+{
+	NetworkContext clientContext;
+	boost::asio::ip::udp::socket probe(clientContext, {boost::asio::ip::udp::v4(), 0});
+	auto discoveryPort = probe.local_endpoint().port();
+	probe.close();
+	boost::system::error_code unavailable;
+	probe.open(boost::asio::ip::udp::v4());
+	probe.bind({boost::asio::ip::udp::v4(), 3030}, unavailable);
+	const bool productionPortAvailable = !unavailable;
+	RecordProperty("automatic_udp_3030_observed", productionPortAvailable ? "true" : "unavailable");
+	probe.close();
+	if(productionPortAvailable)
+		discoveryPort = 3030;
+	CVCMIServer server(0, false);
+	const auto tcpPort = server.prepare(false, true);
+	ASSERT_NE(tcpPort, 0);
+	EXPECT_EQ(server.getPort(), tcpPort);
+	std::shared_ptr<IServerDiscoveryListener> isolatedDiscovery;
+	if(!productionPortAvailable)
+	{
+		// Another instance owns 3030: isolate only the wire-format probe, not lifecycle assertions.
+		isolatedDiscovery = server.getNetworkHandler().createServerDiscoveryListener(server, discoveryPort);
+		isolatedDiscovery->start();
+	}
+#ifdef _WIN32
+	EXPECT_TRUE(listeningSockets().count({IPPROTO_TCP, 0, tcpPort}));
+	if(productionPortAvailable)
+		EXPECT_TRUE(listeningSockets().count({IPPROTO_UDP, 0, 3030}));
+#endif
+	server.setState(EServerState::GAMEPLAY);
+#ifdef _WIN32
+	if(productionPortAvailable)
+		EXPECT_FALSE(listeningSockets().count({IPPROTO_UDP, 0, 3030}));
+#endif
+	server.setState(EServerState::LOBBY);
+#ifdef _WIN32
+	if(productionPortAvailable)
+		EXPECT_TRUE(listeningSockets().count({IPPROTO_UDP, 0, 3030}));
+#endif
+	probe.open(boost::asio::ip::udp::v4());
+	probe.bind({boost::asio::ip::address_v4::loopback(), 0});
+	const std::string request = "VCMI_DISCOVERY";
+	probe.send_to(boost::asio::buffer(request), {boost::asio::ip::address_v4::loopback(), discoveryPort});
+	server.getNetworkHandler().getContext().run_for(std::chrono::milliseconds(100));
+	ASSERT_GT(probe.available(), 0);
+	std::array<char, 128> buffer{};
+	boost::asio::ip::udp::endpoint sender;
+	const auto bytes = probe.receive_from(boost::asio::buffer(buffer), sender);
+	EXPECT_EQ(std::string(buffer.data(), bytes), "VCMI_SERVER:" + std::to_string(tcpPort));
+	boost::asio::ip::tcp::socket connection(clientContext);
+	connection.connect({boost::asio::ip::address_v4::loopback(), tcpPort});
+	server.getNetworkHandler().getContext().run_for(std::chrono::milliseconds(100));
+	EXPECT_EQ(server.activeConnections.size(), 1);
+	if(isolatedDiscovery)
+		isolatedDiscovery->stop();
+	server.setState(EServerState::SHUTDOWN);
+#ifdef _WIN32
+	if(productionPortAvailable)
+		EXPECT_FALSE(listeningSockets().count({IPPROTO_UDP, 0, 3030}));
+#endif
+}
