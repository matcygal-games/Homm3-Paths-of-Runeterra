+namespace
+{
+struct NetworkCalls
+{
+	int tcpCreated = 0;
+	int tcpStarted = 0;
+	int discoveryCreated = 0;
+	int discoveryStarted = 0;
+	int discoveryStopped = 0;
+	int stopped = 0;
+	bool localOnly = false;
+	bool failStart = false;
+	uint16_t requestedPort = 0;
+	uint16_t discoveryPort = 0;
+	uint16_t announcedPort = 0;
+	uint16_t assignedPort = 41777;
+	std::vector<std::string> order;
+};
+
+class RecordingTcpServer : public INetworkServer
+{
+	NetworkCalls & calls;
+public:
+	explicit RecordingTcpServer(NetworkCalls & calls) : calls(calls) {}
+	uint16_t start(uint16_t port, bool localOnly = false) override
+	{
+		++calls.tcpStarted;
+		calls.requestedPort = port;
+		calls.localOnly = localOnly;
+		calls.order.push_back("tcp");
+		if(calls.failStart)
+			throw std::runtime_error("test bind failed");
+		return calls.assignedPort;
+	}
+	void receiveInternalConnection(std::shared_ptr<IInternalConnection>) override {}
+};
+
+class RecordingDiscovery : public IServerDiscoveryListener
+{
+	NetworkCalls & calls;
+	IServerDiscoveryAnnouncer & announcer;
+public:
+	RecordingDiscovery(NetworkCalls & calls, IServerDiscoveryAnnouncer & announcer)
+		: calls(calls), announcer(announcer) {}
+	void start() override
+	{
+		++calls.discoveryStarted;
+		calls.announcedPort = announcer.getPort();
+		calls.order.push_back("discovery");
+	}
+	void stop() override { ++calls.discoveryStopped; }
+};
+
+class RecordingNetwork : public INetworkHandler
+{
+	NetworkCalls & calls;
+	NetworkContext context;
+public:
+	explicit RecordingNetwork(NetworkCalls & calls) : calls(calls) {}
+	std::unique_ptr<INetworkServer> createServerTCP(INetworkServerListener &) override
+	{
+		++calls.tcpCreated;
+		return std::make_unique<RecordingTcpServer>(calls);
+	}
+	std::shared_ptr<IServerDiscoveryListener> createServerDiscoveryListener(IServerDiscoveryAnnouncer & announcer, uint16_t port) override
+	{
+		++calls.discoveryCreated;
+		calls.discoveryPort = port;
+		return std::make_shared<RecordingDiscovery>(calls, announcer);
+	}
+	void connectToRemote(INetworkClientListener &, const std::string &, uint16_t) override {}
+	void createInternalConnection(INetworkClientListener &, INetworkServer &) override {}
+	std::shared_ptr<INetworkConnection> createAsyncConnection(INetworkConnectionListener &) override { return {}; }
+	void createTimer(INetworkTimerListener &, std::chrono::milliseconds) override {}
+	std::shared_ptr<IServerDiscovery> createServerDiscovery(IServerDiscoveryObserver &) override { return {}; }
+	void run() override {}
+	void stop() override { ++calls.stopped; }
+	NetworkContext & getContext() override { return context; }
+};
+
+class ConnectionObserver : public INetworkClientListener
+{
+public:
+	std::shared_ptr<INetworkConnection> connection;
+	std::string failure;
+	void onConnectionEstablished(const std::shared_ptr<INetworkConnection> & value) override { connection = value; }
+	void onConnectionFailed(const std::string & error) override { failure = error; }
+	void onDisconnected(const std::shared_ptr<INetworkConnection> &, const std::string &) override {}
+	void onPacketReceived(const std::shared_ptr<INetworkConnection> &, const std::vector<std::byte> &) override {}
+};
+
+class ScopedLocalPort
+{
+	JsonNode previous = settings["server"]["localPort"];
+public:
+	explicit ScopedLocalPort(uint16_t port)
+	{
+		Settings value = settings.write["server"]["localPort"];
+		value->Integer() = port;
+	}
+	~ScopedLocalPort()
+	{
+		Settings value = settings.write["server"]["localPort"];
+		*value.operator->() = previous;
+	}
+};
+
+class ScopedThreadServer
+{
+public:
+	ServerThreadRunner runner;
+	ScopedThreadServer(bool listen, bool hotseat) { runner.start(listen, false, {}, hotseat); }
+	~ScopedThreadServer() { runner.shutdown(); runner.wait(); }
+};
+
+#ifdef _WIN32
+struct ListeningSocket
+{
+	int protocol;
+	uint32_t address;
+	uint16_t port;
+	bool operator<(const ListeningSocket & other) const
+	{
+		return std::tie(protocol, address, port) < std::tie(other.protocol, other.address, other.port);
+	}
+	bool operator==(const ListeningSocket & other) const = default;
+};
+
+std::set<ListeningSocket> listeningSockets(DWORD process = GetCurrentProcessId())
+{
+	std::set<ListeningSocket> result;
+	DWORD size = 0;
+	GetExtendedTcpTable(nullptr, &size, FALSE, AF_INET, TCP_TABLE_OWNER_PID_LISTENER, 0);
+	std::vector<std::byte> buffer(size);
+	if(GetExtendedTcpTable(buffer.data(), &size, FALSE, AF_INET, TCP_TABLE_OWNER_PID_LISTENER, 0) != NO_ERROR)
+	{
+		ADD_FAILURE() << "Could not inspect owning-PID TCP listeners";
+		return result;
+	}
+	const auto * tcp = reinterpret_cast<const MIB_TCPTABLE_OWNER_PID *>(buffer.data());
+	for(DWORD i = 0; i < tcp->dwNumEntries; ++i)
+		if(tcp->table[i].dwOwningPid == process)
+			result.insert({IPPROTO_TCP, ntohl(tcp->table[i].dwLocalAddr), ntohs(static_cast<u_short>(tcp->table[i].dwLocalPort))});
+	size = 0;
+	GetExtendedUdpTable(nullptr, &size, FALSE, AF_INET, UDP_TABLE_OWNER_PID, 0);
+	buffer.resize(size);
+	if(GetExtendedUdpTable(buffer.data(), &size, FALSE, AF_INET, UDP_TABLE_OWNER_PID, 0) != NO_ERROR)
+	{
+		ADD_FAILURE() << "Could not inspect owning-PID UDP endpoints";
+		return result;
+	}
+	const auto * udp = reinterpret_cast<const MIB_UDPTABLE_OWNER_PID *>(buffer.data());
+	for(DWORD i = 0; i < udp->dwNumEntries; ++i)
+		if(udp->table[i].dwOwningPid == process)
+			result.insert({IPPROTO_UDP, ntohl(udp->table[i].dwLocalAddr), ntohs(static_cast<u_short>(udp->table[i].dwLocalPort))});
+	return result;
+}
+
+DWORD childServerProcess()
+{
+	const auto snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+	if(snapshot == INVALID_HANDLE_VALUE)
+		return 0;
+	PROCESSENTRY32 entry{};
+	entry.dwSize = sizeof(entry);
+	DWORD result = 0;
+	if(Process32First(snapshot, &entry))
+		do
+		{
+			if(entry.th32ParentProcessID == GetCurrentProcessId() && std::filesystem::path(entry.szExeFile).filename() == "VCMI_server.exe")
+				result = entry.th32ProcessID;
+		} while(Process32Next(snapshot, &entry));
+	CloseHandle(snapshot);
+	return result;
+}
+#endif
+}
