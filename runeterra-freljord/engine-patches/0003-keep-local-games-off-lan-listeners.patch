+TEST(LocalServerDiscovery, actualLoopbackTcpBindingDoesNotListenOnAnyAddress)
+{
+	const auto before = listeningSockets();
+	{
+		CVCMIServer server(0, true);
+		const auto port = server.prepare(false, true, true);
+		const auto sockets = listeningSockets();
+		EXPECT_TRUE(sockets.count({IPPROTO_TCP, 0x7f000001, port}));
+		EXPECT_FALSE(sockets.count({IPPROTO_TCP, 0, port}));
+		for(const auto & socket : sockets)
+			if(!before.count(socket))
+				EXPECT_EQ(socket.protocol, IPPROTO_TCP);
+		server.setState(EServerState::SHUTDOWN);
+	}
+	EXPECT_EQ(listeningSockets(), before);
+}
