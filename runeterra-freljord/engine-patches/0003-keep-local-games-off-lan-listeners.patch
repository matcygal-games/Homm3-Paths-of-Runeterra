+TEST(LocalServerDiscovery, actualExternalSingleAndHotseatServersListenOnlyOnLoopback)
+{
+	for(const bool hotseat : {false, true})
+	{
+		NetworkContext context;
+		boost::asio::ip::tcp::acceptor reservation(context, {boost::asio::ip::address_v4::loopback(), 0});
+		const auto port = reservation.local_endpoint().port();
+		reservation.close();
+		ScopedLocalPort configuredPort(port);
+		ServerProcessRunner runner;
+		runner.start(hotseat, false, {}, hotseat);
+		DWORD process = 0;
+		bool listening = false;
+		for(int attempt = 0; attempt < 250 && !listening; ++attempt)
+		{
+			process = childServerProcess();
+			if(process)
+				listening = listeningSockets(process).count({IPPROTO_TCP, 0x7f000001, port});
+			if(!listening)
+				std::this_thread::sleep_for(std::chrono::milliseconds(20));
+		}
+		EXPECT_TRUE(listening) << "actual external local server must bind loopback";
+		if(process)
+		{
+			const auto sockets = listeningSockets(process);
+			EXPECT_EQ(sockets.size(), 1);
+			EXPECT_TRUE(sockets.count({IPPROTO_TCP, 0x7f000001, port}));
+		}
+		runner.shutdown();
+		runner.wait();
+		if(process)
+		{
+			// Windows may retire the owning-PID TCP table entry shortly after process exit.
+			for(int attempt = 0; attempt < 50 && !listeningSockets(process).empty(); ++attempt)
+				std::this_thread::sleep_for(std::chrono::milliseconds(20));
+			EXPECT_TRUE(listeningSockets(process).empty()) << "terminated external server PID " << process;
+		}
+	}
+}
