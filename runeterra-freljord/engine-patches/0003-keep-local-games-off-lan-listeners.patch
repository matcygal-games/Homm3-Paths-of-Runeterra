+TEST(LocalServerDiscovery, failedTcpBindDoesNotAdvertiseAnUnavailableServer)
+{
+	NetworkCalls calls;
+	calls.failStart = true;
+	CVCMIServer server(0, false, std::make_unique<RecordingNetwork>(calls));
+	EXPECT_THROW(server.prepare(false, true), std::runtime_error);
+	EXPECT_EQ(calls.discoveryCreated, 0);
+	server.startDiscoveryListener();
+	EXPECT_EQ(calls.discoveryCreated, 0);
+}
