+TEST(LocalServerDiscovery, constructionAndInternalLocalPreparationOpenNoListener)
+{
+	NetworkCalls calls;
+	CVCMIServer server(0, true, std::make_unique<RecordingNetwork>(calls));
+	EXPECT_EQ(calls.discoveryCreated, 0);
+	EXPECT_EQ(calls.tcpCreated, 0);
+	EXPECT_EQ(server.prepare(false, false), 0);
+	server.startDiscoveryListener();
+	server.setState(EServerState::GAMEPLAY);
+	server.setState(EServerState::LOBBY);
+	EXPECT_EQ(calls.tcpCreated, 1);
+	EXPECT_EQ(calls.tcpStarted, 0);
+	EXPECT_EQ(calls.discoveryCreated, 0);
+	server.setState(EServerState::SHUTDOWN);
+	EXPECT_EQ(calls.stopped, 1);
+}
+
+TEST(LocalServerDiscovery, externalLocalPreparationUsesLoopbackWithoutDiscovery)
+{
+	NetworkCalls calls;
+	CVCMIServer server(0, true, std::make_unique<RecordingNetwork>(calls));
+	EXPECT_EQ(server.prepare(false, true, true), calls.assignedPort);
+	EXPECT_TRUE(calls.localOnly);
+	EXPECT_EQ(calls.tcpStarted, 1);
+	EXPECT_EQ(server.getPort(), calls.assignedPort);
+	server.setState(EServerState::GAMEPLAY);
+	server.setState(EServerState::LOBBY);
+	EXPECT_EQ(calls.discoveryCreated, 0);
+}
+
+TEST(LocalServerDiscovery, lanHostingAdvertisesOnlyAfterBindAndRestartsInLobby)
+{
+	NetworkCalls calls;
+	{
+		CVCMIServer server(0, false, std::make_unique<RecordingNetwork>(calls));
+		EXPECT_EQ(server.prepare(false, true), calls.assignedPort);
+		EXPECT_FALSE(calls.localOnly);
+		EXPECT_EQ(calls.requestedPort, 0);
+		EXPECT_EQ(calls.discoveryPort, 3030);
+		EXPECT_EQ(calls.announcedPort, calls.assignedPort);
+		EXPECT_EQ(calls.order, (std::vector<std::string>{"tcp", "discovery"}));
+		server.setState(EServerState::GAMEPLAY);
+		EXPECT_EQ(calls.discoveryStopped, 1);
+		server.startDiscoveryListener();
+		EXPECT_EQ(calls.discoveryStarted, 1);
+		server.setState(EServerState::LOBBY);
+		EXPECT_EQ(calls.discoveryStarted, 2);
+		server.setState(EServerState::SHUTDOWN);
+		EXPECT_EQ(calls.discoveryStopped, 2);
+	}
+	EXPECT_EQ(calls.discoveryStopped, 2);
+}
