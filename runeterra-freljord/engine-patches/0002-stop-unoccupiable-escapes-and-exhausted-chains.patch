+TEST_F(FailedEscapeRouteTest, friendlyHeroEndpointIsNotAnEscapeButFreeEndpointIs)
+{
+	tbb::global_control singleThread(tbb::global_control::max_allowed_parallelism, 1);
+	TinyH3M::TinyH3MBuilder builder(EMapFormat::SOD);
+	builder.size(36, false).playerActive(PLAYER).playerActive(ENEMY)
+		.hero({5, 5, 0}, HeroTypeID(0), PLAYER).heroGarrison({{CreatureID(0), 1}})
+		.hero({9, 5, 0}, HeroTypeID(2), PLAYER).heroGarrison({{CreatureID(0), 1}})
+		.hero({7, 5, 0}, HeroTypeID(1), ENEMY).heroGarrison({{CreatureID(13), 20}});
+	startWithMap(std::move(builder));
+	revealMap(PLAYER);
+	auto * escapingHero = findHeroAt(int3(5, 5, 0));
+	auto * partner = findHeroAt(int3(9, 5, 0));
+	ASSERT_NE(escapingHero, nullptr);
+	ASSERT_NE(partner, nullptr);
+	escapingHero->setMovementPoints(2000);
+	auto gateway = makeGateway(PLAYER);
+	auto & ai = *gateway->nullkiller;
+	NK2AI::NullkillerTestAccess::prepareState(ai);
+	const auto meetingPaths = ai.pathfinder->getPathInfo(partner->visitablePos());
+	ASSERT_TRUE(std::any_of(meetingPaths.begin(), meetingPaths.end(), [&](const auto & path)
+	{
+		return path.targetHero == escapingHero && path.turn() == 0;
+	})) << "a real same-day friendly meeting must be pathfindable";
+	onlySafeDestination(ai, partner->visitablePos());
+	NK2AI::Goals::EscapeBehavior escape;
+	EXPECT_EQ(findHeroChain(escape.decompose(&ai), escapingHero), nullptr);
+
+	const int3 freeDestination(8, 6, 0);
+	onlySafeDestination(ai, freeDestination);
+	const auto freeGoals = escape.decompose(&ai);
+	const auto * freeChain = findHeroChain(freeGoals, escapingHero);
+	ASSERT_NE(freeChain, nullptr);
+	EXPECT_EQ(freeChain->getPath().targetTile(), freeDestination);
+}
