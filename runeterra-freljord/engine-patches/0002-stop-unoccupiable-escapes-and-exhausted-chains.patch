+TEST_F(FailedEscapeRouteTest, townGarrisonDoesNotBlockEscapeDestination)
+{
+	tbb::global_control singleThread(tbb::global_control::max_allowed_parallelism, 1);
+	TinyH3M::TinyH3MBuilder builder(EMapFormat::SOD);
+	builder.size(36, false).playerActive(PLAYER).playerActive(ENEMY)
+		.hero({5, 5, 0}, HeroTypeID(0), PLAYER).heroGarrison({{CreatureID(0), 1}})
+		.town({14, 8, 0}, FactionID(0), PLAYER)
+		.hero({13, 8, 0}, HeroTypeID(2), PLAYER).heroGarrison({{CreatureID(0), 1}})
+		.hero({7, 5, 0}, HeroTypeID(1), ENEMY).heroGarrison({{CreatureID(13), 20}});
+	startWithMap(std::move(builder));
+	revealMap(PLAYER);
+	auto * escapingHero = findHeroAt(int3(5, 5, 0));
+	auto * garrisonHero = findHeroAt(int3(13, 8, 0));
+	auto * town = findFirst<CGTownInstance>();
+	ASSERT_NE(escapingHero, nullptr);
+	ASSERT_NE(garrisonHero, nullptr);
+	ASSERT_NE(town, nullptr);
+	SetHeroesInTown garrison;
+	garrison.tid = town->id;
+	garrison.garrison = garrisonHero->id;
+	gameState()->apply(garrison);
+	ASSERT_TRUE(garrisonHero->isGarrisoned());
+	ASSERT_EQ(town->getGarrisonHero(), garrisonHero);
+	escapingHero->setMovementPoints(2000);
+	auto gateway = makeGateway(PLAYER);
+	auto & ai = *gateway->nullkiller;
+	NK2AI::NullkillerTestAccess::prepareState(ai);
+	onlySafeDestination(ai, town->visitablePos());
+	const auto goals = NK2AI::Goals::EscapeBehavior().decompose(&ai);
+	const auto * chain = findHeroChain(goals, escapingHero);
+	ASSERT_NE(chain, nullptr);
+	EXPECT_EQ(chain->getPath().targetTile(), town->visitablePos());
+}
