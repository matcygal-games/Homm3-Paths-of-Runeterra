@@ -0,0 +1,33 @@
+/*
+ * ExpectedConnectionClosures.h, part of VCMI engine
+ *
+ * Authors: listed in file AUTHORS in main folder
+ *
+ * License: GNU General Public License v2.0 or later
+ * Full text of license available in license.txt file, in main folder
+ *
+ */
+#pragma once
+
+#include <memory>
+#include <set>
+
+class INetworkConnection;
+
+/// Local close requests remain identifiable until queued transport callbacks release the connection.
+class ExpectedConnectionClosures
+{
+	std::set<std::weak_ptr<INetworkConnection>, std::owner_less<>> connections;
+
+public:
+	void add(const std::shared_ptr<INetworkConnection> & connection)
+	{
+		std::erase_if(connections, [](const auto & entry) { return entry.expired(); });
+		connections.insert(connection);
+	}
+
+	bool contains(const std::shared_ptr<INetworkConnection> & connection) const
+	{
+		return connections.contains(connection);
+	}
+};
