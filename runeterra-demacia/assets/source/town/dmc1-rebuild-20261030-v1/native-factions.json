            "special4"
          ],
          "upgrades": "special4"
        },
        "dwellingUpLvl1": {
          "cost": {
            "gold": 1000,
            "ore": 5
          },
          "description": "Recruits Veteran Badgerbears and upgrades Loyal Badgerbears for the difference in full recruitment costs.",
