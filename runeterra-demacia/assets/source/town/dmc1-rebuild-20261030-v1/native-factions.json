            "gems": 5,
            "gold": 7500,
            "ore": 10
          },
          "description": "Recruits melee Mageseeker Inquisitors and upgrades Mageseekers for the difference in full recruitment costs. Enemy mana surcharge increases to +2, using the strongest eligible stack.",
          "name": "Inquisitor Chapterhouse",
          "upgrades": "dwellingLvl6"
        },
        "dwellingUpLvl7": {
          "cost": {
            "gems": 10,
            "gold": 15000,
            "ore": 10
          },
          "description": "Recruits Elder Silverwing Lancers and upgrades Silverwing Lancers for the difference in full recruitment costs. Veteran bonded pairs fly farther; they do not cast Shield.",
