        },
        "mageGuild1": {
          "cost": {
            "gold": 2000,
            "ore": 5,
            "wood": 5
          },
          "description": "Teaches five level-one spells, sells spellbooks and replenishes visiting heroes' mana overnight. The library emphasizes protection and aid.",
