        "special1": {
          "bonuses": [
            {
              "description": "Town petricite protection: 20% magical spell damage reduction; strongest faction protection only.",
              "stacking": "runeterraDemaciaPetricite",
              "subtype": "any",
              "type": "SPELL_DAMAGE_REDUCTION",
              "val": 20
            }
          ],
          "cost": {
            "gems": 5,
            "gold": 6000,
            "ore": 10
          },
          "description": "During town defense, reduces magical spell damage to the defending army by 20%. Uses only the strongest Demacian petricite protection, capped at 60% from faction sources. Debuffs still work. It reveals no hidden heroes.",
          "name": "Mageseeker Tower",
          "requires": [
            "allOf",
            [
              "fort"
            ],
            [
              "mageGuild1"
            ]
          ]
        },
        "special2": {
          "configuration": {
            "canRefuse": false,
            "onVisitedMessage": "This hero has already completed the Aviary's reconnaissance training.",
            "rewards": [
              {
                "bonuses": [
                  {
                    "description": "Demacian reconnaissance training grants +1 sight radius; strongest Demacian training or specialty only.",
                    "duration": "PERMANENT",
                    "stacking": "runeterraDemaciaScouting",
                    "type": "SIGHT_RADIUS",
                    "val": 1,
                    "valueType": "ADDITIVE_VALUE"
                  }
                ],
                "message": "The Aviary's patrol instructors teach you to read the terrain. Sight radius increases by one; further Demacian scouting sources do not stack."
              }
            ],
            "selectMode": "selectFirst",
            "showInInfobox": true,
            "visitMode": "hero"
          },
          "cost": {
            "gems": 2,
            "gold": 2500,
            "wood": 8
          },
          "description": "Visiting heroes automatically receive permanent reconnaissance training: +1 sight radius, confirmed by a brief information message. Demacian training and Quinn's specialty share a maximum bonus of +1; native Scouting adds separately. Silverwing raptors support regional patrols; Valor is Quinn's unique azurite eagle companion.",
          "manualHeroVisit": false,
          "name": "Silverwing Aviary",
          "requires": [
            "dwellingLvl2"
