          ],
          "configuration": {
            "canRefuse": false,
            "onEmptyMessage": "A local Ranger volunteers as an escort. Free an army slot or bring an existing Demacian Ranger stack; the town's weekly claim remains available.",
            "onVisitedMessage": "The Sanctuary's volunteers have already departed this week. Its charitable work continues.",
