+/* Optional creature preview resources: real native selection, geometry and persistence controls. */
+#include "StdInc.h"
+
+#include "lib/CCreatureHandler.h"
+#include "lib/ExceptionsCommon.h"
+#include "lib/GameLibrary.h"
+#include "lib/Rect.h"
+#include "lib/bonuses/BonusParameters.h"
+#include "lib/bonuses/Propagators.h"
+#include "lib/bonuses/Updaters.h"
+#include "lib/json/JsonNode.h"
+#include "lib/json/JsonValidator.h"
+#include "lib/serializer/CMemorySerializer.h"
+#include "lib/serializer/JsonDeserializer.h"
+#include "lib/serializer/JsonSerializer.h"
+
+namespace
+{
+void expectRect(const Rect & actual, int x, int y, int w, int h)
+{
+	EXPECT_EQ(actual.x, x);
+	EXPECT_EQ(actual.y, y);
+	EXPECT_EQ(actual.w, w);
+	EXPECT_EQ(actual.h, h);
+}
+
+void setDoubleWide(CCreature & creature, bool value)
+{
+	JsonNode node;
+	node["doubleWide"].Bool() = value;
+	JsonDeserializer loader(nullptr, node);
+	creature.serializeJson(loader);
+}
+
+class PreviewLoader : public CCreatureHandler
+{
+public:
+	using CCreatureHandler::loadFromJson;
+};
+}
+
+TEST(CreaturePreview, OptionalPathSelectionNeverChangesBattlePath)
+{
+	CCreature creature;
+	creature.animDefName = AnimationPath::builtin("CPKMAN.DEF");
+	EXPECT_TRUE(creature.previewAnimDefName.empty());
+	EXPECT_EQ(creature.getPreviewAnimation(), creature.animDefName);
+	creature.previewAnimDefName = AnimationPath::builtin("own/preview.json");
+	EXPECT_EQ(creature.getPreviewAnimation(), creature.previewAnimDefName);
+	EXPECT_EQ(creature.animDefName, AnimationPath::builtin("CPKMAN.DEF"));
+}
+
+TEST(CreaturePreview, EveryLoadedOriginalTownCreatureRetainsLegacyPathAndBothCrops)
+{
+	size_t originalTownCreatures = 0;
+	LIBRARY->creh->forEach([&](const Creature * base, bool &)
+	{
+		const auto * creature = dynamic_cast<const CCreature *>(base);
+		ASSERT_NE(creature, nullptr);
+		if (creature->getModScope() != "core" || creature->getFactionID().getNum() < 0
+			|| creature->getFactionID().getNum() >= 9)
+			return;
+		++originalTownCreatures;
+		EXPECT_TRUE(creature->previewAnimDefName.empty()) << creature->getJsonKey();
+		EXPECT_EQ(creature->getPreviewAnimation(), creature->animDefName);
+		const int x = creature->isDoubleWide() ? 170 : 150;
+		expectRect(creature->getPreviewAnimationCrop(Point(450, 400), Point(100, 120)), x, 155, 100, 120);
+		expectRect(creature->getPreviewAnimationCrop(Point(450, 400), Point(100, 130)), x, 155, 100, 130);
+	});
+	EXPECT_GE(originalTownCreatures, 126U);
+}
+
+TEST(CreaturePreview, OneCompactCanvasCentersBothFootprintsInFortAndLargePanels)
+{
+	CCreature creature;
+	creature.previewAnimDefName = AnimationPath::builtin("own/preview.json");
+	for (bool doubleWide : {false, true})
+	{
+		setDoubleWide(creature, doubleWide);
+		expectRect(creature.getPreviewAnimationCrop(Point(100, 130), Point(100, 120)), 0, 5, 100, 120);
+		expectRect(creature.getPreviewAnimationCrop(Point(100, 130), Point(100, 130)), 0, 0, 100, 130);
+		// An authored center at50,65 projects to50,60 or50,65 respectively.
+		auto crop = creature.getPreviewAnimationCrop(Point(100, 130), Point(100, 120));
+		EXPECT_EQ(50 - crop.x, 50);
+		EXPECT_EQ(65 - crop.y, 60);
+	}
+}
+
+TEST(CreaturePreview, CustomCanvasCropUsesOneFixedCameraAndRejectsTooSmallResources)
+{
+	CCreature creature;
+	creature.previewAnimDefName = AnimationPath::builtin("own/preview.json");
+	expectRect(creature.getPreviewAnimationCrop(Point(104, 134), Point(100, 120)), 2, 7, 100, 120);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(99, 130), Point(100, 120)), std::invalid_argument);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(100, 119), Point(100, 120)), std::invalid_argument);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(100, 129), Point(100, 130)), std::invalid_argument);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(100, 130), Point(0, 120)), std::invalid_argument);
+}
+
+TEST(CreaturePreview, PresentationFieldDoesNotChangeJsonOrBinarySavedState)
+{
+	CCreature creature;
+	JsonNode beforeJson;
+	JsonSerializer beforeWriter(nullptr, beforeJson);
+	creature.serializeJson(beforeWriter);
+	CMemorySerializer beforeBinary;
+	beforeBinary.oser & creature;
+	auto beforeBytes = beforeBinary.extractBuffer();
+	creature.previewAnimDefName = AnimationPath::builtin("own/preview.json");
+	JsonNode afterJson;
+	JsonSerializer afterWriter(nullptr, afterJson);
+	creature.serializeJson(afterWriter);
+	CMemorySerializer afterBinary;
+	afterBinary.oser & creature;
+	EXPECT_EQ(beforeJson, afterJson);
+	EXPECT_EQ(beforeBytes, afterBinary.extractBuffer());
+	EXPECT_TRUE(afterJson["graphics"].isNull());
+	EXPECT_TRUE(afterJson["animationPreview"].isNull());
+}
+
+TEST(CreaturePreview, NativeGraphicsSchemaAcceptsOptionalPathAndRejectsWrongTypes)
+{
+	const JsonNode schema(JsonPath::builtin("config/schemas/creature.json"));
+	const std::string text = R"({"animation":"CPKMAN.DEF","animationTime":{"attack":1,"walk":1,"idle":10},"timeBetweenFidgets":1})";
+	JsonNode graphics(text.data(), text.size(), "CreaturePreviewSchema");
+	graphics.setModScope("core", true);
+	JsonValidator validator;
+	EXPECT_TRUE(validator.check(schema["properties"]["graphics"], graphics).empty());
+	graphics["animationPreview"].String() = "CPKMAN.DEF";
+	graphics.setModScope("core", true);
+	EXPECT_TRUE(validator.check(schema["properties"]["graphics"], graphics).empty());
+	graphics["animationPreview"].String() = "";
+	graphics.setModScope("core", true);
+	EXPECT_FALSE(validator.check(schema["properties"]["graphics"], graphics).empty());
+	graphics["animationPreview"].Bool() = true;
+	graphics.setModScope("core", true);
+	EXPECT_FALSE(validator.check(schema["properties"]["graphics"], graphics).empty());
+}
+
+TEST(CreaturePreview, MissingExplicitPreviewFailsTheRealNativeLoader)
+{
+	const std::string text = R"({
+		"name":{"singular":"Preview missing resource probe","plural":"Preview missing resource probes"},
+		"faction":"core:castle","special":true,"disabled":false,"growth":1,"level":1,
+		"hitPoints":1,"speed":1,"attack":1,"defense":1,"damage":{"min":1,"max":1},
+		"graphics":{"animation":"CPKMAN.DEF","animationPreview":"nonexistent-preview-probe.json",
+		"animationTime":{"attack":1,"walk":1,"idle":10},"timeBetweenFidgets":1}
+	})";
+	JsonNode node(text.data(), text.size(), "CreaturePreviewMissing");
+	node.setModScope("core");
+	PreviewLoader handler;
+	try
+	{
+		handler.loadFromJson("core", node, "previewMissingResourceProbe", 100000);
+		FAIL() << "An explicit unavailable preview must fail before object registration";
+	}
+	catch (const ModLoadingException & error)
+	{
+		EXPECT_NE(std::string(error.what()).find("animationPreview"), std::string::npos);
+	}
+}
