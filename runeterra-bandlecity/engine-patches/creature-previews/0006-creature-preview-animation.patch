+
+Rect CCreature::getPreviewAnimationCrop(const Point & canvasSize, const Point & viewportSize) const
+{
+	if (previewAnimDefName.empty())
+		return Rect(isDoubleWide() ? 170 : 150, 155, viewportSize.x, viewportSize.y);
+
+	if (viewportSize.x <= 0 || viewportSize.y <= 0 || canvasSize.x < viewportSize.x || canvasSize.y < viewportSize.y)
+		throw std::invalid_argument("Creature preview animation canvas is smaller than its UI viewport");
+
+	return Rect((canvasSize.x - viewportSize.x) / 2, (canvasSize.y - viewportSize.y) / 2, viewportSize.x, viewportSize.y);
+}
