+TEST(CreaturePreview, ExplicitLegacyPreviewRetainsBothOriginalCropsAndBattlePath)
+{
+	CCreature creature;
+	creature.animDefName = AnimationPath::builtin("CPKMAN.DEF");
+	creature.previewAnimDefName = AnimationPath::builtin("own/retimed-preview.json");
+	creature.previewAnimationLegacyCrop = true;
+	for (bool doubleWide : {false, true})
+	{
+		setDoubleWide(creature, doubleWide);
+		const int x = doubleWide ? 170 : 150;
+		expectRect(creature.getPreviewAnimationCrop(Point(450, 400), Point(100, 120)), x, 155, 100, 120);
+		expectRect(creature.getPreviewAnimationCrop(Point(450, 400), Point(100, 130)), x, 155, 100, 130);
+		EXPECT_EQ(creature.getPreviewAnimation(), creature.previewAnimDefName);
+		EXPECT_EQ(creature.animDefName, AnimationPath::builtin("CPKMAN.DEF"));
+	}
+}
+
+TEST(CreaturePreview, LegacyPreviewCropIsOptInAndChecksItsEntireViewport)
+{
+	CCreature creature;
+	creature.previewAnimDefName = AnimationPath::builtin("own/retimed-preview.json");
+	// Existing compact/custom resources keep the exact centered route by default.
+	expectRect(creature.getPreviewAnimationCrop(Point(450, 400), Point(100, 130)), 175, 135, 100, 130);
+	expectRect(creature.getPreviewAnimationCrop(Point(100, 130), Point(100, 120)), 0, 5, 100, 120);
+	creature.previewAnimationLegacyCrop = true;
+	setDoubleWide(creature, false);
+	expectRect(creature.getPreviewAnimationCrop(Point(250, 285), Point(100, 130)), 150, 155, 100, 130);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(249, 285), Point(100, 130)), std::invalid_argument);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(250, 284), Point(100, 130)), std::invalid_argument);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(450, 400), Point(0, 130)), std::invalid_argument);
+	setDoubleWide(creature, true);
+	expectRect(creature.getPreviewAnimationCrop(Point(270, 285), Point(100, 130)), 170, 155, 100, 130);
+	EXPECT_THROW(creature.getPreviewAnimationCrop(Point(269, 285), Point(100, 130)), std::invalid_argument);
+}
+
+TEST(CreaturePreview, LegacyCropSchemaAcceptsOnlyBooleanValues)
+{
+	const JsonNode schema(JsonPath::builtin("config/schemas/creature.json"));
+	const std::string text = R"({"animation":"CPKMAN.DEF","animationPreview":"CPKMAN.DEF","animationTime":{"attack":1,"walk":1,"idle":10},"timeBetweenFidgets":1})";
+	JsonNode graphics(text.data(), text.size(), "CreaturePreviewLegacyCropSchema");
+	JsonValidator validator;
+	for (bool value : {false, true})
+	{
+		graphics["animationPreviewLegacyCrop"].Bool() = value;
+		graphics.setModScope("core", true);
+		EXPECT_TRUE(validator.check(schema["properties"]["graphics"], graphics).empty());
+	}
+	graphics["animationPreviewLegacyCrop"].String() = "true";
+	graphics.setModScope("core", true);
+	EXPECT_FALSE(validator.check(schema["properties"]["graphics"], graphics).empty());
+	graphics["animationPreviewLegacyCrop"].Integer() = 1;
+	graphics.setModScope("core", true);
+	EXPECT_FALSE(validator.check(schema["properties"]["graphics"], graphics).empty());
+}
+
+TEST(CreaturePreview, LegacyCropWithoutExplicitPreviewFailsNativeLoader)
+{
+	const std::string text = R"({
+		"name":{"singular":"Legacy preview crop probe","plural":"Legacy preview crop probes"},
+		"faction":"core:castle","special":true,"disabled":false,"growth":1,"level":1,
+		"hitPoints":1,"speed":1,"attack":1,"defense":1,"damage":{"min":1,"max":1},
+		"graphics":{"animation":"CPKMAN.DEF","animationPreviewLegacyCrop":true,
+		"animationTime":{"attack":1,"walk":1,"idle":10},"timeBetweenFidgets":1}
+	})";
+	JsonNode node(text.data(), text.size(), "CreaturePreviewLegacyCropMissing");
+	node.setModScope("core");
+	PreviewLoader handler;
+	try
+	{
+		handler.loadFromJson("core", node, "previewLegacyCropMissing", 100001);
+		FAIL() << "A legacy crop request requires an explicit UI-only animation resource";
+	}
+	catch (const ModLoadingException & error)
+	{
+		EXPECT_NE(std::string(error.what()).find("animationPreviewLegacyCrop"), std::string::npos);
+	}
+}
