+TEST_F(HeroLossReplanning, realNormalDefeatCancelsMovingHeroTaskAndReplansWithoutErrors)
+{
+	ASSERT_NO_FATAL_FAILURE(start());
+	auto movementTask = task();
+	RecordingLogger logger;
+	std::shared_lock lock(CGameState::mutex);
+	EXPECT_FALSE(NK2AI::NullkillerTestAccess::executeTask(*gateway->nullkiller, movementTask));
+	EXPECT_EQ(client->server.normalResults, 1);
+	EXPECT_EQ(client->server.removedOwnHeroes, 1);
+	EXPECT_EQ(gameState()->getHero(heroID), nullptr);
+	EXPECT_EQ(client->movementRequests, 1);
+	EXPECT_TRUE(logger.errors.empty());
+	EXPECT_TRUE(vstd::contains_if(logger.information, [](const std::string & text) { return text.find("removed after a lost battle; cancelling its task and replanning") != std::string::npos; }));
+	preparePlanning(*gateway);
+	const auto heroes = gateway->nullkiller->getHeroesForPathfinding();
+	EXPECT_EQ(heroes.size(), 1);
+	EXPECT_NE(heroes.begin()->first->id, heroID);
+}
