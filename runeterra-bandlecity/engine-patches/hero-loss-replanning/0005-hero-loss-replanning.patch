+class LossServer : public GameHandlerTestServer
+{
+	std::shared_ptr<CGameState> state;
+public:
+	explicit LossServer(const std::shared_ptr<CGameState> & state) : GameHandlerTestServer(state, PLAYER), state(state) {}
+	NK2AI::AIGateway * gateway = nullptr;
+	bool omitRemovalCallback = false;
+	bool invalidObservedResult = false, invalidObservedWinner = false;
+	std::vector<EBattleResult> resultTypes;
+	int normalResults = 0, removedOwnHeroes = 0;
+	void applyPack(CPackForClient & pack) override
+	{
+		if(auto * result = dynamic_cast<BattleResult *>(&pack))
+		{
+			if(result->result == EBattleResult::NORMAL) ++normalResults;
+			resultTypes.push_back(result->result);
+			auto observed = *result;
+			if(invalidObservedResult) observed.result = static_cast<EBattleResult>(99);
+			if(invalidObservedWinner) observed.winner = static_cast<BattleSide>(99);
+			gateway->battleEnd(result->battleID, &observed, QuestionID::NONE);
+			gateway->cc->onBattleEnded(result->battleID);
+		}
+		if(auto * removal = dynamic_cast<RemoveObject *>(&pack))
+		{
+			auto * object = state->getObjInstance(removal->objectID);
+			if(object && object->ID == Obj::HERO && object->getOwner() == PLAYER) ++removedOwnHeroes;
+			if(object && !omitRemovalCallback) gateway->objectRemoved(object, removal->initiator);
+		}
+		GameHandlerTestServer::applyPack(pack);
+		if(auto * start = dynamic_cast<BattleStart *>(&pack))
+		{
+			gateway->cc->onBattleStarted(state->getBattle(start->battleID));
+			// Tactical decisions are deliberately outside this adventure-task regression.
+			gateway->battleAI = std::make_shared<PassiveBattleInterface>();
+			gateway->status.setBattle(NK2AI::ONGOING_BATTLE);
+		}
+		if(auto * movement = dynamic_cast<TryMoveHero *>(&pack)) gateway->heroMoved(*movement, false);
+		if(dynamic_cast<BattleEnded *>(&pack)) gateway->battleEnded();
+	}
+};
+
+class LossClient : public IClient
+{
+	std::shared_ptr<CGameState> state;
+	int requestID = 0;
+public:
+	LossServer server;
+	CGameHandler handler;
+	int movementRequests = 0;
+	bool removeWithoutBattle = false;
+	bool removeWinner = false;
+	bool attackerWins = false;
+	EBattleResult outcome = EBattleResult::NORMAL;
+	ObjectInstanceID otherAttacker = ObjectInstanceID::NONE, otherDefender = ObjectInstanceID::NONE;
+	bool battleEndActionAccepted = false;
+	explicit LossClient(const std::shared_ptr<CGameState> & state) : state(state), server(state), handler(server, state)
+	{
+		state->actingPlayers.insert(PLAYER);
+		handler.randomizer->setSeed(1337);
+	}
+	std::optional<BattleAction> makeSurrenderRetreatDecision(PlayerColor, const BattleID &, const BattleStateInfoForRetreat &) override { return std::nullopt; }
+	int sendRequest(const CPackForServer & request, PlayerColor player, bool) override
+	{
+		if(const auto * settings = dynamic_cast<const SaveLocalState *>(&request))
+		{
+			*state->getPlayerState(settings->player)->playerLocalSettings = settings->data;
+			return ++requestID;
+		}
+		request.player = player;
+		request.requestID = ++requestID;
+		const auto * movement = dynamic_cast<const MoveHero *>(&request);
+		if(movement) ++movementRequests;
+		auto copy = CMemorySerializer::deepCopy(request);
+		handler.handleReceivedPack(GameConnectionID::FIRST_CONNECTION, *copy);
+		if(movement && state->currentBattles.empty() && otherAttacker.hasValue() && otherDefender.hasValue())
+			handler.battles->startBattle(state->getHero(otherAttacker), state->getHero(otherDefender));
+		if(movement && !state->currentBattles.empty())
+		{
+			const auto battleID = state->currentBattles.front()->getBattleID();
+			const auto * battle = state->getBattle(battleID);
+			if(outcome == EBattleResult::ESCAPE || outcome == EBattleResult::SURRENDER)
+			{
+				auto * info = state->currentBattles.front().get();
+				info->tacticDistance = 0;
+				for(const auto & stack : info->stacks)
+					if(stack->unitSide() == BattleSide::ATTACKER && !stack->isTurret()) { info->activeStack = stack->unitId(); break; }
+				MakeAction action(outcome == EBattleResult::ESCAPE ? BattleAction::makeRetreat(BattleSide::ATTACKER) : BattleAction::makeSurrender(BattleSide::ATTACKER));
+				action.battleID = battleID;
+				action.player = player;
+				action.requestID = ++requestID;
+				const auto before = server.resultTypes.size();
+				handler.handleReceivedPack(GameConnectionID::FIRST_CONNECTION, action);
+				battleEndActionAccepted = server.resultTypes.size() == before + 1;
+				if(!battleEndActionAccepted)
+				{
+					// Complete the fixture instead of leaving the movement waiter blocked;
+					// explicit action/result assertions still fail the rejected-action case.
+					BattleResultProcessor rejected(&handler);
+					rejected.setBattleResult(*battle, EBattleResult::NORMAL, BattleSide::DEFENDER);
+					rejected.endBattle(*battle);
+				}
+			}
+			else
+			{
+				// Exercise real normal-result finalization/removal with a fixed outcome.
+				BattleResultProcessor result(&handler);
+				result.setBattleResult(*battle, EBattleResult::NORMAL, attackerWins ? BattleSide::ATTACKER : BattleSide::DEFENDER);
+				result.endBattle(*battle);
+			}
+		}
+		if(movement && (removeWithoutBattle || removeWinner) && state->getHero(movement->hid))
+		{
+			RemoveObject removal(movement->hid, PLAYER);
+			server.applyPack(removal);
+		}
+		return requestID;
+	}
+};
