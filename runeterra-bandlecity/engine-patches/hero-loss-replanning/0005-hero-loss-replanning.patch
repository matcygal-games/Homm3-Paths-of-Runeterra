+class HeroLossReplanning : public NullkillerTest
+{
+protected:
+	Services * gameServices() override { return LIBRARY; }
+	void start(bool battleTarget = true)
+	{
+		TinyH3M::TinyH3MBuilder builder(EMapFormat::SOD);
+		builder.size(36, false).playerActive(PLAYER)
+			.hero({6,5,0}, HeroTypeID(0), PLAYER).heroGarrison({{CreatureID(0),1}})
+			.hero({12,12,0}, HeroTypeID(1), PLAYER).heroGarrison({{CreatureID(0),1}})
+			.playerActive(ENEMY)
+			.hero(battleTarget ? int3(7,5,0) : int3(30,30,0), HeroTypeID(2), ENEMY).heroGarrison({{CreatureID(0),10}});
+		startWithMap(std::move(builder));
+		revealMap(PLAYER);
+		hero = findHeroAt({6,5,0});
+		ASSERT_NE(hero, nullptr);
+		heroID = hero->id;
+		hero->setMovementPoints(2000);
+		gameState()->getPlayerState(PLAYER)->resources[EGameResID::GOLD] = 10000;
+		client = std::make_unique<LossClient>(gameState());
+		callback = makeCallback(PLAYER, client.get());
+		gateway = makeGateway(callback);
+		client->server.gateway = gateway.get();
+	}
+	NK2AI::Goals::TTask task() const
+	{
+		NK2AI::AIPath path;
+		path.targetHero = hero;
+		path.heroArmy = hero;
+		path.chainMask = 1;
+		path.nodes.push_back(pathNode(*hero, hero->visitablePos() + int3(1,0,0)));
+		path.nodes.push_back(pathNode(*hero, hero->visitablePos()));
+		return std::make_shared<NK2AI::Goals::ExecuteHeroChain>(path);
+	}
+	std::unique_ptr<LossClient> client;
+	std::shared_ptr<CCallback> callback;
+	std::unique_ptr<NK2AI::AIGateway> gateway;
+	CGHeroInstance * hero = nullptr;
+	ObjectInstanceID heroID;
+};
+}
